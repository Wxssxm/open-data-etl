# Where to land the raw download (CSV). Gitignored.
DATA_RAW_DIR=data/raw

# Where to write the dimensional Parquet warehouse. Gitignored.
WAREHOUSE_DIR=data/warehouse

# DVF source URL (data.gouv.fr publishes one CSV per year)
DVF_BASE_URL=https://files.data.gouv.fr/geo-dvf/latest/csv

# Default year + departement to ingest. departement=75 = Paris.
DVF_YEAR=2023
DVF_DEPARTEMENT=75

LOG_LEVEL=INFO
